{
  "name": "greatnecksouthapp-official",
  "type": "module",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write . && eslint . --fix",
    "format:check": "prettier --check . && eslint .",
    "test:school-data": "node --experimental-strip-types --test 'scripts/school-data/**/*.test.ts'",
    "postinstall": "patch-package",
    "test:app": "TZ=America/New_York node --experimental-strip-types --test 'lib/**/*.test.ts'",
    "test": "npm run test:school-data && npm run test:app"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "axios": "^1.13.2",
    "expo": "~58.0.0",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "patch-package": "^8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-calendars": "github:craftworkco/react-native-calendars#feat/test-updates-from-upstream",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.4",
    "typescript": "~6.0.3"
  },
  "private": true,
  "overrides": {
    "glob@^13": "^14.0.4",
    "minimatch@^10": "^11.0.6",
    "react-native-calendars": {
      "react-native-safe-area-context": "$react-native-safe-area-context"
    }
  }
}
